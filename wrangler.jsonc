{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-squared-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "workers_dev": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
